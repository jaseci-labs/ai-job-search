"""Install the dependencies of every portal CLI under .agents/skills/.

Run from anywhere: neojac run jobsearch -- install_portal_clis [--dry-run]

The CLIs are discovered, not listed: every `.agents/skills/*/cli/package.json`
is installed, the same glob CI's discover-clis job uses. A portal generated by
/add-portal or copied from another fork is therefore picked up on a fresh clone
without anyone editing an install loop, and a portal removed from the tree
stops being asked for.

One command for every shell, since Python is already a prerequisite - the
README previously carried a PowerShell and a Bash loop, each with its own
hand-copied list of portal names.

A manifest that declares an npm/bun lifecycle script, trustedDependencies or
workspaces, or that has a bunfig.toml or .npmrc beside it, is skipped and reported
instead of installed: those are the doors that run code or reconfigure the
install during `bun install`, and tools/security_guards.jac forbids them
in-tree. A borrowed portal that carries one gets read by a human before it
runs.

Every install also passes --ignore-scripts, including on older Bun releases
that run a built-in list of dependency hooks without trustedDependencies.

Each CLI installs independently; one failure does not stop the rest. Exit 0
when every CLI installed, 1 when bun is missing, a manifest was skipped, or an
install failed.
"""

import builtins;

import from jaclang.comptime { target }

import argparse;

import json;

import os;

import shutil;

import subprocess;

import sys;

import from pathlib { Path }

glob ROOT: any;

glob _BUN_CANDIDATE_DIRS: any;

with entry {
    ROOT = Path(os.environ.get("JOBSEARCH_ROOT") or Path(__file__).resolve().parent.parent);
    root_default_ = ROOT;
}

glob root_default_: any;

"""Return each portal CLI directory, sorted by portal name."""
def discover(`root: Path = root_default_) -> builtins.list[Path];

"""Why this manifest must not be installed unattended, or None when it is safe."""
def unsafe_reason(cli_dir: Path) -> builtins.str | None;

glob root_default__: any;

glob run_default_: any;

with entry {
    root_default__ = ROOT;
    run_default_ = subprocess.run;
}

def install(
    cli_dirs: builtins.list[Path],
    bun: builtins.str,
    dry_run: builtins.bool,
    `root: Path = root_default__,
    run=run_default_,
) -> builtins.int;

with entry {
    _BUN_CANDIDATE_DIRS = (
        "~/.bun/bin",
        "/opt/homebrew/bin",
        "/usr/local/bin",
        "/home/linuxbrew/.linuxbrew/bin",
        "~/.linuxbrew/bin",
        "~/.local/bin",
        "/usr/bin",
    );
    candidate_dirs_default_ = _BUN_CANDIDATE_DIRS;
}

glob candidate_dirs_default_: any;

"""Return `bun` on PATH, or at a standard install location."""
def find_bun(candidate_dirs: any = candidate_dirs_default_) -> builtins.str | None;

"""Write UTF-8 whatever the host's default encoding is (a fork's portal name may not be ASCII)."""
def _force_utf8_output -> None;

def main(argv=None) -> builtins.int;

with entry:__main__ {
    sys.exit(main());
}
