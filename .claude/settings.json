      "Bash(curl --data:*)",
      "Bash(curl -F:*)",
      "Bash(curl --form:*)",
      "Bash(curl -T:*)",
      "Bash(curl --upload-file:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -XPOST:*)",
      "Bash(curl --request POST:*)",
      "Bash(wget --post-data:*)",
      "Bash(wget --post-file:*)",
      "Bash(wget --method=POST:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ssh:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)"
    ]
  }
}
